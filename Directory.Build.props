<Project>
  <PropertyGroup>
    <Authors>clareLab</Authors>
    <RepositoryUrl>https://github.com/clareLab/sts2-slpp</RepositoryUrl>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>9.0</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);work/**;backups/**;validation/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
